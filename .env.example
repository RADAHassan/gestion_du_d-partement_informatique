# =====================================================================
# Variables d'environnement - copier en .env : cp .env.example .env
# (scripts/init.sh le fait et génère un JWT_SECRET aléatoire)
# =====================================================================

# --- Base de données PostgreSQL ---
POSTGRES_DB=dept_info
POSTGRES_USER=dept_admin
POSTGRES_PASSWORD=ChangeMe-Db-Password-2024

# --- Backend ---
# Secret de signature des JWT : >= 32 caractères aléatoires (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
# Durée de validité par défaut du code de pointage (minutes)
POINTAGE_MINUTES=15
# Origine(s) publique(s) du site (liste séparée par des virgules) - protection CSRF/CORS
CORS_ORIGIN=http://localhost:8080

# --- Frontend ---
# Port exposé sur la machine hôte
FRONTEND_PORT=8080

# --- Sauvegardes (scripts/backup_db.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
